# SmartBrief 后端配置示例：复制为 .env 并填入真实值
# 支持任意 OpenAI 兼容接口（DeepSeek / Kimi / Ollama 等），只需改 BASE_URL 与 MODEL

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL=gpt-4o-mini
# Judge 评审模型（可选，评测用）：与被测系统解耦，避免自评同源；不配则与主系统同模型
# JUDGE_MODEL=deepseek-reasoner

# ===== 嵌入模型配置（第 26 节 RAG，复用 SiliconFlow 兼容 OpenAI Embeddings 接口）=====
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-xxxx
EMBEDDING_MODEL=BAAI/bge-m3

# ===== Tavily 专业搜索（可选；配置后 web_search 优先走 Tavily，行业研究类结果质量更高）=====
TAVILY_API_KEY=tvly-xxxx
# api.tavily.com 为境外服务，国内网络需配代理（仅 Tavily 请求走代理，不影响其它调用）
TAVILY_PROXY=http://127.0.0.1:9674
